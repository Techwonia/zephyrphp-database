{
    "name": "zephyrphp/database",
    "description": "Database module for ZephyrPHP - Doctrine ORM integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "zephyrphp/framework": "^0.1|^0.2|^0.3|^1.0|dev-main",
        "doctrine/orm": "^2.14",
        "doctrine/dbal": "^3.6",
        "symfony/cache": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "ZephyrPHP\\Database\\": "src/"
        }
    },
    "extra": {
        "zephyr": {
            "module": "database",
            "config": "config/database.php"
        }
    }
}
